# Copy to .env (never commit it) and fill in your own values. Every value below is a demo.

# --- OpenAI (https://platform.openai.com/api-keys) ---
OPENAI_API_KEY=sk-your-key-here
# Model used for the replies (default: gpt-5.5, the one named in the OpenAI SDK's README)
OPENAI_MODEL=gpt-5.5
# Only for tests, proxies or an OpenAI-compatible server
OPENAI_BASE_URL=
# The vector store the chatbot searches. Create it once with:  lilac-chatbot init-knowledge --shopify
# (or --file PATH for your own documents). Without it the chatbot answers from its instructions only.
VECTOR_STORE_ID=

# --- Web app ---
# Signs the session cookie (at least 16 characters). It must stay the same between restarts:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change-me-to-a-long-random-string
# Where users reach the app. https:// makes the session cookie Secure.
PUBLIC_URL=http://localhost:5003
DATABASE_URL=sqlite:///chatbot.db

# --- Behaviour (all optional) ---
# Time zone used for "Good morning / afternoon / evening" and the day of the week (the brief says Central time)
TIMEZONE=America/Chicago
# Seconds to wait for OpenAI
REQUEST_TIMEOUT=60
MAX_OUTPUT_TOKENS=700
# Longest customer message accepted, in characters
MAX_QUERY_CHARS=2000
# The chat page waits CHAT_PAUSE_SECONDS, shows "typing" and holds the answer back
# CHAT_SECONDS_PER_WORD per word of the answer, at most CHAT_MAX_TYPING_SECONDS. Set 0 to answer at once.
CHAT_PAUSE_SECONDS=10
CHAT_SECONDS_PER_WORD=0.66
CHAT_MAX_TYPING_SECONDS=30

# --- Shopify product catalogue (only read by `lilac-chatbot init-knowledge --shopify`) ---
# The *.myshopify.com domain, and an Admin API access token with the read_products scope
SHOPIFY_SHOP=
SHOPIFY_ACCESS_TOKEN=
# Admin API version (default 2026-10)
SHOPIFY_API_VERSION=2026-10
